# Legacy local fallback. Prefer DISCORD_BOT_TOKEN in backend/.env.
# Discord Bot Token (get from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_bot_token_here

# Backend API URL
BACKEND_API_URL=http://localhost:8000

# Must match backend DISCORD_BACKEND_SHARED_SECRET
DISCORD_BACKEND_SHARED_SECRET=minimum-32-character-bot-to-backend-secret

# Optional pilot/development guild ID for immediate slash-command updates.
DISCORD_GUILD_ID=your_numeric_guild_id

# Per-Student: User to Course Bot Mapping (JSON format)
# Each student gets their own course. Get user IDs: Right-click user → Copy ID (enable Developer Mode)
# Get course bot IDs: curl http://localhost:8000/course-bots
USER_COURSE_MAPPING={"discord_user_id_1": "course-bot-uuid-1", "discord_user_id_2": "course-bot-uuid-2"}

# Optional: Channel to Course fallback (for server channels when user has no per-student mapping)
# CHANNEL_COURSE_MAPPING={"channel_id": "course-bot-uuid"}

# Backend .env (for share links): DISCORD_CLIENT_ID, FRONTEND_URL, DISCORD_INVITE_URL
# Backend also needs DISCORD_BOT_TOKEN for the dashboard "Send message" feature (instructor DMs to students)

# Optional: Session timeout in seconds (default: 3600 = 1 hour)
# SESSION_TIMEOUT=3600

# Optional: Request timeout in seconds (default: 30)
# REQUEST_TIMEOUT=30

# Optional: Logging level (default: INFO)
# LOG_LEVEL=INFO
